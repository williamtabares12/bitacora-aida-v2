// firestore.rules — spec, sección 5.
//
// Publicadas en la consola de Firebase y verificadas ahí mismo con el
// "Rules playground" (el emulador local de Firestore no se pudo usar
// desde el entorno donde se escribió este archivo: storage.googleapis.com
// bloqueado; el playground de la consola cubre el mismo caso sin
// necesitarlo). Fase 6, 5/5 simulaciones correctas:
//   1. get /usuarios/uidA/entradas/entrada1, autenticada como uidA → permitir
//   2. get /usuarios/uidB/entradas/entrada1, autenticada como uidA → denegar
//      (el caso clave: una usuaria no puede leer las entradas de otra)
//   3. get /configuracion/parametros, autenticada como uidA          → permitir
//   4. update /configuracion/parametros, autenticada como uidA       → denegar
//   5. get /configuracion/parametros, sin autenticar                → denegar

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuaria autenticada solo puede leer y escribir sus propias
    // entradas — nunca las de otra uid.
    match /usuarios/{uid}/entradas/{entradaId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier usuaria autenticada puede leer los parámetros del
    // convenio, pero nadie puede escribirlos desde la app: eso se edita a
    // mano desde la consola de Firebase (spec, sección 11).
    match /configuracion/parametros {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Todo lo demás — incluido usuarios/{uid} en sí, que hoy la app no
    // usa — denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
